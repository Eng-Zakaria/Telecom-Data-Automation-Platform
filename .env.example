# Local (default): talks to the azure-local-lab emulators, no secrets needed.
CLOUDKIT_MODE=local
# LAB_PG_PORT=5433
# OPENLINEAGE_URL=http://localhost:5000     # send lineage to Marquez instead of artifacts/lineage/

# Azure: fill from `terraform output cloudkit_env` in infra/environments/<env>,
# then `az login` (or run inside Azure with a managed identity). No keys here.
# CLOUDKIT_MODE=azure
# AZURE_STORAGE_ACCOUNT=
# AZURE_EVENTHUBS_NAMESPACE=
# AZURE_KEY_VAULT_NAME=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# LAKE_USE_AZURE_CLI=true                  # deltalake uses your az login token
