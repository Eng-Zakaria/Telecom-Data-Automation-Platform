AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Development environment
ENVIRONMENT=dev
USE_LOCAL_DEV=true
LOCATION=eastus2
RESOURCE_GROUP_NAME=rg-telecom-dev
KEYVAULT_NAME=kv-telecom-dev
STORAGE_ACCOUNT_NAME=sttelecomdev001
EVENTHUBS_NAMESPACE=eh-telecom-dev
DATABRICKS_WORKSPACE_NAME=dbx-telecom-dev
FABRIC_WORKSPACE_NAME=fbc-telecom-dev

# Local dev stack ports
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9092
POSTGRES_PORT=5432

# Storage connection strings (secrets stored in Key Vault in production)
BLOB_CONNECTION_STRING=https://${STORAGE_ACCOUNT_NAME}.blob.core.windows.net
S3_ENDPOINT=http://localhost:9000
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/telecom
